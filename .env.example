# Copy to .env and fill in your own provider configuration.
# The page can open without these values; writing requires your own key and model.
# All writing uses real model calls. There is no demo data mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional model overrides. Empty values fall back to LLM_MODEL.
# Research and planning: sloop. Tutoring, editing and review: galleon.
MODEL_RAFT=
MODEL_SLOOP=
MODEL_GALLEON=
MODEL_ARK=

# Optional background, such as familiar languages and preferred explanation depth.
# Leave blank for neutral prompts. This text may be sent to the model provider.
AUTHOR_PROFILE=

# Token limit parameter accepted by your provider.
TOKEN_PARAM=max_tokens

# Optional minimum output budget for reasoning models, shared by Web writing steps.
# Blank or 0 keeps each step's default. Must not exceed CHAT_TOKENS_CAP (default 16000).
# DeepSeek V4 Pro starting point: 4096. See docs/deepseek.md.
LLM_MIN_OUTPUT_TOKENS=

# Optional connection timeout in seconds (1-120). Blank keeps the SDK default.
# Changes connect only; read/write/pool timeouts and SDK retries stay unchanged.
# If repeated connect timeouts occur, try 20. Restart the backend after editing.
LLM_CONNECT_TIMEOUT_SECONDS=

# Optional local paths. Defaults put writing under local_artifacts/blogs/.
# LOCAL_ARTIFACTS_DIR=local_artifacts
# MAKINGOF_MATERIAL=local_artifacts/blogs/material.md
# MAKINGOF_OUT=local_artifacts/blogs/draft-makingof.md

# Optional compatible gateway ledger. No sibling project is searched automatically.
# GW_LEDGER=local_artifacts/gateway.jsonl
